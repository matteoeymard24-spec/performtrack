rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== FONCTIONS =====================
    function isSignedIn() {
      return request.auth != null;
    }

    // Profil du compte connecté (users/{uid}).
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (me().get('role', '') == 'admin' || me().get('superAdmin', false) == true);
    }

    function isSuperAdmin() {
      return isSignedIn() && me().get('superAdmin', false) == true;
    }

    // Coach de l'athlète connecté (null = compte d'avant le système coach).
    function myCoachId() {
      return me().get('coachId', null);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // L'athlète userId est-il rattaché au coach connecté ?
    function isMyAthlete(userId) {
      return isAdmin() &&
        get(/databases/$(database)/documents/users/$(userId)).data.get('coachId', null) == request.auth.uid;
    }

    // ===================== USERS =====================
    match /users/{userId} {
      // Superadmin : tout. Coach : lui-même, SES athlètes, et les autres coachs (noms).
      allow read: if isOwner(userId) || isSuperAdmin() ||
        (isAdmin() && (resource.data.coachId == request.auth.uid || resource.data.role == 'admin'));

      // Inscription : l'athlète crée son profil en attente (jamais admin / approuvé).
      allow create: if isSuperAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'athlete') &&
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending')
      );

      allow update: if isSuperAdmin() ||
        // Coach : valide / modifie SES athlètes, sans les changer de coach ni de rôle.
        (
          isAdmin() && !isOwner(userId) &&
          resource.data.get('coachId', null) == request.auth.uid &&
          request.resource.data.get('coachId', null) == request.auth.uid &&
          request.resource.data.get('role', 'athlete') == resource.data.get('role', 'athlete') &&
          request.resource.data.get('superAdmin', false) == resource.data.get('superAdmin', false)
        ) ||
        // Chacun modifie son propre profil, sans toucher rôle / superadmin / groupe / coach / statut.
        (
          isOwner(userId) &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
          (!('superAdmin' in request.resource.data) ||
            request.resource.data.superAdmin == (resource.data.superAdmin == true)) &&
          (!('group' in request.resource.data) || request.resource.data.group == resource.data.group) &&
          (!('coachId' in request.resource.data) ||
            request.resource.data.coachId == resource.data.get('coachId', null)) &&
          (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
        );

      allow delete: if isSuperAdmin();

      // Sous-collections (rm, tests, weight_history...)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isSuperAdmin() || isMyAthlete(userId);
      }
    }

    // ===================== WORKOUT (séances) =====================
    match /workout/{workoutId} {
      // Superadmin : tout. Coach : ses séances. Athlète rattaché : séances de son
      // coach + celles qui le ciblent. Athlète sans coach : tout (comme avant).
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        (!isAdmin() && (myCoachId() == null || resource.data.createdBy == myCoachId()))
      );

      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.createdBy == request.auth.uid);

      // Coach : ses séances. Athlète : uniquement SA ligne de userProgress.
      allow update: if isSuperAdmin() ||
        (isAdmin() && resource.data.createdBy == request.auth.uid) ||
        (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userProgress']) &&
          (
            !('userProgress' in resource.data) ||
            request.resource.data.userProgress.diff(resource.data.userProgress).affectedKeys().hasOnly([request.auth.uid])
          )
        );

      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.createdBy == request.auth.uid);
    }

    // ===================== WELLNESS =====================
    match /wellness/{wellnessId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ===================== INJURIES (blessures) =====================
    match /injuries/{injuryId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ===================== GROUPS (groupes personnalisés) =====================
    match /groups/{groupId} {
      // Lecture : tout compte connecté (chaque athlète doit savoir dans quels groupes il est).
      allow read: if isSignedIn();
      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isSuperAdmin() || (isAdmin() && resource.data.createdBy == request.auth.uid);
    }

    // ===================== EXERCISE MEDIA (banque d'exos commune) =====================
    match /exerciseMedia/{exerciseKey} {
      allow read: if isSignedIn();
      // Chaque coach crée ses fiches ; il ne modifie / supprime que les siennes.
      // Sur une fiche commune il peut seulement la masquer pour lui (hiddenFor).
      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isSuperAdmin() || (isAdmin() && (
        resource.data.get('createdBy', null) == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor', 'updatedAt'])
      ));
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.get('createdBy', null) == request.auth.uid);
    }

    // ===================== EXERCISE IMAGES (photos des exos, à part) =====================
    // Même droits que la fiche exerciseMedia du même nom.
    match /exerciseImages/{exerciseKey} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || (isAdmin() && (
        !exists(/databases/$(database)/documents/exerciseMedia/$(exerciseKey)) ||
        get(/databases/$(database)/documents/exerciseMedia/$(exerciseKey)).data.get('createdBy', null) == request.auth.uid
      ));
    }

    // ===================== CYCLES (planification) =====================
    match /cycles/{cycleId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        (!isAdmin() && (myCoachId() == null || resource.data.createdBy == myCoachId()))
      );
      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isSuperAdmin() || (isAdmin() && resource.data.createdBy == request.auth.uid);
    }

    // ===================== FIXTURES (matchs / compétitions) =====================
    match /fixtures/{fixtureId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        (!isAdmin() && (myCoachId() == null || resource.data.createdBy == myCoachId()))
      );
      // Coach : ses matchs. Athlète : ses propres échéances (portée "user:<son uid>").
      allow create: if isSuperAdmin() || (
        isSignedIn() && request.resource.data.createdBy == request.auth.uid &&
        (isAdmin() || request.resource.data.scope == 'user:' + request.auth.uid)
      );
      allow update, delete: if isSuperAdmin() || (
        isSignedIn() && resource.data.createdBy == request.auth.uid
      );
    }

    // ===================== COACH CODES =====================
    match /coachCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isSuperAdmin() || (isAdmin() && resource.data.coachId == request.auth.uid);
    }

    // ===================== ARCHIVED ATHLETES =====================
    match /archivedAthletes/{athleteId} {
      allow read, write: if isAdmin();
    }
  }
}
