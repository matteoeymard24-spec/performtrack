rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // ATTENTION : le champ réellement utilisé partout dans l'app (Dashboard,
      // Admin, ACWRMonitoring, AuthProvider) est "superAdmin", pas
      // "isSuperAdmin". Une version précédente de ces règles vérifiait
      // "isSuperAdmin", un champ qui n'existe nulle part côté app — la garde
      // anti-auto-promotion ci-dessous ne protégeait donc PAS le vrai champ
      // "superAdmin", qu'un athlète aurait pu s'attribuer directement.
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.superAdmin == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ========== USERS ==========
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // FAILLE CORRIGÉE ICI : avant, "allow write" laissait n'importe quel
      // athlète authentifié écrire N'IMPORTE QUOI dans son propre document
      // users/{sonUid} — y compris role: "admin" ou isSuperAdmin: true. Un
      // athlète pouvait donc s'auto-promouvoir admin en un seul appel
      // Firestore SDK depuis la console du navigateur, sans jamais passer
      // par l'interface. Un athlète peut toujours modifier son propre
      // profil (poids, prénom, etc.), mais ne peut plus jamais changer son
      // rôle, son statut superAdmin, ni son groupe (assigné par le coach) —
      // seul un admin (vérifié côté serveur, pas côté client) peut toucher
      // ces trois champs.
      // "status" gère l'autorisation d'accès à la première connexion : un
      // athlète qui s'inscrit lui-même ne peut créer son profil qu'avec
      // status = 'pending' (jamais 'approved' directement), et ne peut plus
      // jamais changer son propre statut ensuite (seul un admin approuve ou
      // refuse). L'absence du champ (comptes créés avant cette fonctionnalité)
      // est traitée comme "approuvé" côté app.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'athlete') &&
        (!('superAdmin' in request.resource.data) || request.resource.data.superAdmin == false) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending')
      );

      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('superAdmin' in request.resource.data) ||
          request.resource.data.superAdmin == (resource.data.superAdmin == true)) &&
        (!('group' in request.resource.data) || request.resource.data.group == resource.data.group) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status)
      );

      allow delete: if isAdmin();

      // Sous-collections (rm, weight_history)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ========== WORKOUT ==========
    match /workout/{workoutId} {
      // Lecture : tous les utilisateurs authentifiés
      allow read: if isSignedIn();

      // Création : admins uniquement
      allow create: if isAdmin();

      // Mise à jour : admins OU athlètes qui modifient UNIQUEMENT leur
      // propre entrée dans userProgress.
      // BUG CORRIGÉ ICI : la condition précédente faisait
      // request.resource.data.userProgress.diff(resource.data.userProgress)
      // sans jamais vérifier que resource.data.userProgress existait déjà.
      // Or aucune séance n'était créée avec un champ userProgress initial
      // (voir Workout.jsx) — donc pour TOUTE séance, le tout premier
      // athlète qui essayait de démarrer se heurtait à un .diff() sur un
      // champ inexistant, provoquant une erreur d'évaluation de la règle et
      // donc un refus d'écriture systématique. Le garde-fou
      // "!('userProgress' in resource.data)" corrige ça pour les séances
      // déjà existantes en base ; côté app, Workout.jsx initialise
      // maintenant userProgress: {} dès la création pour que ça ne se
      // reproduise plus.
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userProgress']) &&
        (
          !('userProgress' in resource.data) ||
          request.resource.data.userProgress.diff(resource.data.userProgress).affectedKeys().hasOnly([request.auth.uid])
        )
      );

      // Suppression : admins uniquement
      allow delete: if isAdmin();
    }

    // ========== WELLNESS ==========
    match /wellness/{wellnessId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Un athlète peut modifier son propre wellness, mais ne peut pas en
      // changer le userId (empêche de "reléguer" son propre document à un
      // autre athlète ou de perturber les requêtes admin).
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );

      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ========== INJURIES (journal de blessures — nouvelle collection) ==========
    match /injuries/{injuryId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );

      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ========== GROUPS (groupes personnalisés d'athlètes) ==========
    match /groups/{groupId} {
      // Lecture : tout utilisateur authentifié (nécessaire pour que chaque
      // athlète sache de quels groupes il fait partie et voie les séances
      // ciblées dessus).
      allow read: if isSignedIn();

      // Écriture (création / modification / suppression) : admins uniquement
      allow write: if isAdmin();
    }

    // ========== EXERCISE MEDIA (photos/gifs de démonstration, une seule
    // fois par nom d'exercice — voir Workout.jsx) ==========
    match /exerciseMedia/{exerciseKey} {
      // Lecture : tout utilisateur authentifié (le coach ET les athlètes
      // voient la photo pendant la séance).
      allow read: if isSignedIn();

      // Écriture (création / modification / suppression) : admins
      // uniquement. Cette collection ne contient qu'UN document par
      // exercice (dédupliqué), donc bien moins coûteuse que si l'image
      // était recopiée dans chaque séance.
      allow write: if isAdmin();
    }
  }
}
